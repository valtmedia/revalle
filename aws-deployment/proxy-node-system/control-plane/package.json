{
  "name": "proxy-node-control-plane",
  "version": "2.0.0",
  "description": "Control plane for proxy node management system - Full enterprise proxy infrastructure",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --watch src --watch routes --watch config.js server.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch --detectOpenHandles",
    "test:coverage": "jest --coverage --detectOpenHandles --forceExit",
    "lint": "eslint . --ext .js --max-warnings 0",
    "lint:fix": "eslint . --ext .js --fix",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "build:docker": "docker build -t proxy-control-plane .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f control-plane",
    "health": "curl -s http://localhost:3000/health | node -e \"process.stdin.pipe(process.stdout)\""
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "socket.io": "^4.6.1",
    "axios": "^1.6.0",
    "redis": "^4.6.10",
    "mysql2": "^3.6.3",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "dotenv": "^16.3.1",
    "prom-client": "^15.0.0",
    "node-forge": "^1.3.1",
    "geoip-lite": "^1.4.10",
    "uuid": "^9.0.0",
    "ms": "^2.1.3",
    "on-finished": "^2.4.1",
    "http-errors": "^2.0.0",
    "joi": "^17.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "eslint": "^8.54.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "coverageDirectory": "coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "routes/**/*.js",
      "!src/middleware/**"
    ],
    "testTimeout": 30000
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/proxy-node-system.git"
  },
  "license": "MIT",
  "keywords": [
    "proxy",
    "squid",
    "aws",
    "load-balancer",
    "control-plane",
    "node-management"
  ]
}
